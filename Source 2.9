local function GetPlayerRole(player)
    local character = player.Character
    local backpack = player.Backpack
    
    if (backpack and backpack:FindFirstChild("Knife")) or (character and character:FindFirstChild("Knife")) then
        return "Murderer"
    elseif (backpack and backpack:FindFirstChild("Gun")) or (character and character:FindFirstChild("Gun")) then
        return "Sheriff"
    elseif (character and character:FindFirstChild("FakeGun")) then
        return "Hero"
    end
    return "Innocent"
end

local function GetRoleColor(role)
    if role == "Murderer" then return Settings.ESP.MurdererColor end
    if role == "Sheriff" then return Settings.ESP.SheriffColor end
    if role == "Hero" then return Settings.ESP.HeroColor end
    return Settings.ESP.InnocentColor
end


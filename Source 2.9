-- Scrape fallback (no API key): parse Next.js __NEXT_DATA__ JSON from the public site
local function scrapeScriptHub(query)
    setHubStatus("No API key — scraping rscripts.net...", COLORS.TextDim)
    local url = "https://rscripts.net/"
    if query and query ~= "" then
        url = "https://rscripts.net/scripts?q=" .. HttpService:UrlEncode(query)
    end
    local html = httpGet(url)
    if not html then
        setHubStatus("Could not reach rscripts.net. Add your API key to retry.", Color3.fromRGB(255, 80, 80))
        return
    end

    local json = extractNextData(html)
    if json then
        local ok, data = pcall(HttpService.JSONDecode, HttpService, json)
        if ok and data then
            local collected, seen = {}, {}
            local function walk(obj, depth)
                if depth > 14 then return end
                if type(obj) ~= "table" then return end
                if type(obj.title) == "string" and type(obj.slug) == "string" and (obj.imageUrl or (obj.game and obj.game.thumbnailUrl) or (obj.game and obj.game.placeId)) then
                    if not seen[obj.slug] then
                        seen[obj.slug] = true
                        table.insert(collected, normalizeScript(obj))
                    end
                end
                for _, v in pairs(obj) do
                    walk(v, depth + 1)
                end
            end
            walk(data, 0)
            if #collected > 0 then
                setHubStatus("Scraped " .. #collected .. " scripts from rscripts.net (no key)", COLORS.AccentGold)
                renderScriptHubCards(collected)
                return
            end
        end
    end
    setHubStatus("Could not parse rscripts.net. Use your API key for full access.", Color3.fromRGB(255, 150, 0))
end

local function fetchScriptHubScripts(query)
    if not apiKey or apiKey == "" then
        scrapeScriptHub(query)
        return
    end

    setHubStatus(query and ("Searching rscripts.net for \"" .. query .. "\"...") or "Loading latest scripts...", COLORS.TextDim)
    local headers = { ["Authorization"] = "Bearer " .. apiKey }
    local url
    if query and query ~= "" then
        url = "https://api.rscripts.net/v1/search?q=" .. HttpService:UrlEncode(query) .. "&index=scripts&limit=24"
    else
        url = "https://api.rscripts.net/v1/scripts?limit=24&sort=newest"
    end

    local body = httpGet(url, headers)
    if not body then
        setHubStatus("API request failed (check key). Falling back to scrape...", Color3.fromRGB(255, 150, 0))
        scrapeScriptHub(query)
        return
    end

    local ok, data = pcall(HttpService.JSONDecode, HttpService, body)
    if not ok or not data or not data.success then
        local msg = "API error"
        if ok and data and data.error and data.error.message then msg = "API error: " .. data.error.message end
        setHubStatus(msg, Color3.fromRGB(255, 80, 80))
        return
    end

    local scripts = {}
    if type(data.data) == "table" then
        if data.data.scripts then
            scripts = data.data.scripts
        elseif data.data[1] then
            scripts = data.data
        end
    end

    if #scripts == 0 then
        setHubStatus("No scripts found" .. (query and (" for \"" .. query .. "\"") or "") .. ".", COLORS.TextDim)
        renderScriptHubCards({})
        return
    end

    local norm = {}
    for _, s in ipairs(scripts) do
        table.insert(norm, normalizeScript(s))
    end
    setHubStatus("Loaded " .. #norm .. " scripts from rscripts.net" .. (query and (" for \"" .. query .. "\"") or ""), COLORS.AccentGold)
    renderScriptHubCards(norm)
end

local hubSearchThread = nil
local function searchScriptHub(query)
    if hubSearchThread then task.cancel(hubSearchThread) end
    hubSearchThread = task.delay(0.5, function()
        fetchScriptHubScripts(query)
    end)
end


-- Loading Sequence
local function startLoading()
    spawn(function()
        while LoadingOverlay.Visible do
            TweenService:Create(LoadingSquare, TweenInfo.new(1, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
                Rotation = 90
            }):Play()
            wait(1)
            TweenService:Create(LoadingSquare, TweenInfo.new(1, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
                Rotation = 180
            }):Play()
            wait(1)
            TweenService:Create(LoadingSquare, TweenInfo.new(1, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
                Rotation = 270
            }):Play()
            wait(1)
            TweenService:Create(LoadingSquare, TweenInfo.new(1, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
                Rotation = 360
            }):Play()
            wait(1)
            LoadingSquare.Rotation = 0
        end
    end)

    local steps = {"Verifying License...", "Fetching App Manifest...", "Connecting to Backend...", "Loading Assets...", "Ready!"}
    for _, step in ipairs(steps) do
        LoadingStatus.Text = step:upper()
        wait(0.8)
    end

    local fadeOut = TweenService:Create(LoadingOverlay, TweenInfo.new(1), {BackgroundTransparency = 1})
    TweenService:Create(LoadingSquare, TweenInfo.new(0.5), {BackgroundTransparency = 1}):Play()
    TweenService:Create(LoadingText, TweenInfo.new(0.5), {TextTransparency = 1}):Play()
    TweenService:Create(LoadingStatus, TweenInfo.new(0.5), {TextTransparency = 1}):Play()
    fadeOut:Play()
    fadeOut.Completed:Connect(function()
        LoadingOverlay.Visible = false
        MainFrame.Visible = true
        MainFrame.Size = UDim2.new(0, 0, 0, 0)
        TweenService:Create(MainFrame, TweenInfo.new(0.5, Enum.EasingStyle.Back), {Size = UDim2.new(0, 800, 0, 500)}):Play()
    end)
end


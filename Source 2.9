local ESP_Table = {}

local function CreateESP(Player)
    local Box = Drawing.new("Square")
    local Name = Drawing.new("Text")
    local Tracer = Drawing.new("Line")
    local Health = Drawing.new("Line")

    Box.Visible = false; Box.Thickness = 1; Box.Color = Config.EspColor
    Name.Visible = false; Name.Center = true; Name.Outline = true; Name.Size = 14; Name.Color = Color3.new(1, 1, 1)
    Tracer.Visible = false; Tracer.Thickness = 1; Tracer.Color = Config.EspColor
    Health.Visible = false; Health.Thickness = 2; Health.Color = Color3.new(0, 1, 0)

    ESP_Table[Player] = {Box = Box, Name = Name, Tracer = Tracer, Health = Health}
end

for _, p in pairs(Players:GetPlayers()) do
    if p ~= LocalPlayer then CreateESP(p) end
end
Players.PlayerAdded:Connect(CreateESP)
Players.PlayerRemoving:Connect(function(p)
    if ESP_Table[p] then
        for _, v in pairs(ESP_Table[p]) do v:Remove() end
        ESP_Table[p] = nil
    end
end)

local function IsVisible(part)
    if not Config.WallCheck then return true end
    local ray = Ray.new(Camera.CFrame.Position, (part.Position - Camera.CFrame.Position).Unit * Config.MaxDistance)
    local hit = workspace:FindPartOnRayWithIgnoreList(ray, {LocalPlayer.Character, part.Parent})
    return hit == nil or hit:IsDescendantOf(part.Parent)
end

local function GetClosestTarget()
    local target = nil
    local maxDist = Config.FOVRadius
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild(Config.TargetPart) then
            if Config.TeamCheck and player.Team == LocalPlayer.Team then continue end
            local hum = player.Character:FindFirstChild("Humanoid")
            if hum and hum.Health <= 0 then continue end

            local part = player.Character[Config.TargetPart]
            local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
            local dist = (Vector2.new(screenPos.X, screenPos.Y) - UserInputService:GetMouseLocation()).Magnitude
            
            if onScreen and dist <= maxDist and IsVisible(part) then
                maxDist = dist
                target = part
            end
        end
    end
    return target
end

local lastTriggerTime = 0

local function PerformTriggerAction()
    local btn = Config.TriggerMouseButton == 1 and "MouseButton1" or "MouseButton2"
    local pressFunc = btn == "MouseButton1" and mouse1press or mouse2press
    local releaseFunc = btn == "MouseButton1" and mouse1release or mouse2release
    
    if pressFunc and releaseFunc then
        pressFunc()
        task.wait(Config.TriggerHoldTime / 1000)
        releaseFunc()
    end
end

local function RunTriggerbot()
    if not Config.TriggerEnabled then return end
    
    if Config.TriggerActivationKey then
        local keyPressed = UserInputService:IsMouseButtonPressed(Config.AimKey)
        if Config.TriggerKeyMode == 1 and not keyPressed then return end
    end

    if tick() - lastTriggerTime < (Config.TriggerInterval / 1000) then return end

    local mousePos = UserInputService:GetMouseLocation()
    local ray = Camera:ViewportPointToRay(mousePos.X, mousePos.Y)
    
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Blacklist
    params.FilterDescendantsInstances = {LocalPlayer.Character}
    
    local result = workspace:Raycast(ray.Origin, ray.Direction * Config.TriggerMaxDist, params)
    
    if result and result.Instance then
        local hit = result.Instance
        local character = hit:FindFirstAncestorOfClass("Model")
        local player = Players:GetPlayerFromCharacter(character)
        
        if player and player ~= LocalPlayer then
            if Config.TriggerTeamCheck and player.Team == LocalPlayer.Team then return end
            local hum = character:FindFirstChildOfClass("Humanoid")
            if Config.TriggerHumOnly and not hum then return end
            if hum and hum.Health <= 0 then return end
            if Config.TriggerIgnoreFF and character:FindFirstChildOfClass("ForceField") then return end
            if Config.TriggerHeadOnly and hit.Name ~= "Head" then return end
            local dist = (Camera.CFrame.Position - hit.Position).Magnitude
            if dist > Config.TriggerMaxDist then return end

            if Config.TriggerUseDelay then
                local d = Config.TriggerDelay
                if Config.TriggerRandomize then
                    d = math.random(Config.TriggerMinDelay, Config.TriggerMaxDelay)
                end
                task.wait(d / 1000)
            end

            lastTriggerTime = tick()
            PerformTriggerAction()
        end
    end
end

local CurrentTarget = nil

RunService.RenderStepped:Connect(function()
    FOVCircle.Position = UserInputService:GetMouseLocation()
    if Config.RainbowFOV then FOVCircle.Color = Color3.fromHSV(tick() % 5 / 5, 1, 1) end

    local isAiming = Config.Enabled and UserInputService:IsMouseButtonPressed(Config.AimKey)
    
    if isAiming then
        if not (Config.StickyAim and CurrentTarget and CurrentTarget.Parent) then
            CurrentTarget = GetClosestTarget()
        end
        
        if CurrentTarget then
            local targetPos = CurrentTarget.Position
            if Config.Prediction then targetPos = targetPos + (CurrentTarget.Velocity * Config.PredictionAmount) end
            
            if Config.Shake > 0 then
                targetPos = targetPos + Vector3.new(math.random(-Config.Shake, Config.Shake)/10, math.random(-Config.Shake, Config.Shake)/10, math.random(-Config.Shake, Config.Shake)/10)
            end

            local aimCF = CFrame.new(Camera.CFrame.Position, targetPos)
            Camera.CFrame = Camera.CFrame:Lerp(aimCF, 1 / math.max(1, Config.Smoothing))
        end
    else
        CurrentTarget = nil
    end

    task.spawn(RunTriggerbot)

    for player, drawings in pairs(ESP_Table) do
        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChild("Humanoid")
        
        if Config.EspEnabled and root and hum and hum.Health > 0 then
            if Config.EspTeamCheck and player.Team == LocalPlayer.Team then
                for _, d in pairs(drawings) do d.Visible = false end
                continue
            end

            local pos, onScreen = Camera:WorldToViewportPoint(root.Position)
            if onScreen then
                local top = Camera:WorldToViewportPoint(root.Position + Vector3.new(0, 3, 0))
                local bottom = Camera:WorldToViewportPoint(root.Position + Vector3.new(0, -3.5, 0))
                local height = math.abs(top.Y - bottom.Y)
                local width = height / 1.5
                
                if Config.EspBoxes then
                    drawings.Box.Visible = true
                    drawings.Box.Size = Vector2.new(width, height)
                    drawings.Box.Position = Vector2.new(pos.X - width/2, pos.Y - height/2)
                else drawings.Box.Visible = false end

                if Config.EspNames then
                    drawings.Name.Visible = true
                    drawings.Name.Position = Vector2.new(pos.X, pos.Y - height/2 - 15)
                    local distText = Config.EspDistance and " [" .. math.floor((Camera.CFrame.Position - root.Position).Magnitude) .. "m]" or ""
                    drawings.Name.Text = player.Name .. distText
                else drawings.Name.Visible = false end

                if Config.EspTracers then
                    drawings.Tracer.Visible = true
                    drawings.Tracer.From = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)
                    drawings.Tracer.To = Vector2.new(pos.X, pos.Y + height/2)
                else drawings.Tracer.Visible = false end

                if Config.EspHealth then
                    drawings.Health.Visible = true
                    drawings.Health.From = Vector2.new(pos.X - width/2 - 5, pos.Y + height/2)
                    drawings.Health.To = Vector2.new(pos.X - width/2 - 5, (pos.Y + height/2) - (height * (hum.Health/hum.MaxHealth)))
                    drawings.Health.Color = Color3.fromHSV((hum.Health/hum.MaxHealth) * 0.3, 1, 1)
                else drawings.Health.Visible = false end
            else
                for _, d in pairs(drawings) do d.Visible = false end
            end
        else
            for _, d in pairs(drawings) do d.Visible = false end
        end
    end
end)
]]


        local code = nil
        -- 1) rawScript URL is public
        if script.rawScript then
            local body = httpGet(script.rawScript)
            if body and body:len() > 0 then code = body end
        end
        -- 2) fallback: API detail endpoint (needs key)
        if not code and script.slug then
            local headers = {}
            if apiKey and apiKey ~= "" then headers["Authorization"] = "Bearer " .. apiKey end
            local body = httpGet("https://api.rscripts.net/v1/scripts/" .. script.slug, headers)
            if body then
                local ok, data = pcall(HttpService.JSONDecode, HttpService, body)
                if ok and data and data.data and data.data.script then
                    code = data.data.script
                end
            end
        end

        if not code then
            injectBtn.Text = "FAILED TO FETCH"
            injectBtn.BackgroundColor3 = Color3.fromRGB(180, 0, 0)
            notify("ScriptHub: could not fetch '" .. (script.title or "script") .. "'")
            return
        end

        local func, err = loadstring(code)
        if not func then
            injectBtn.Text = "COMPILE ERROR"
            injectBtn.BackgroundColor3 = Color3.fromRGB(180, 0, 0)
            warn("[ScriptHub] compile error:", err)
            return
        end

        local okRun, runErr = pcall(func)
        if okRun then
            injectBtn.Text = "✓ INJECTED"
            injectBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 0)
            notify("'" .. (script.title or "Script") .. "' injected!")
        else
            injectBtn.Text = "RUNTIME ERROR"
            injectBtn.BackgroundColor3 = Color3.fromRGB(180, 0, 0)
            warn("[ScriptHub] runtime error:", runErr)
        end
    end)
end


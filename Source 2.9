local function CreateSlider(parent, name, min, max, current, callback)
    local Frame = Instance.new("Frame")
    Frame.Name = name
    Frame.Size = UDim2.new(1, -20, 0, 70)
    Frame.BackgroundColor3 = THEME.Secondary
    Frame.BorderSizePixel = 0
    Frame.Parent = parent

    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 4)
    Corner.Parent = Frame

    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(1, -20, 0, 35)
    Label.Position = UDim2.new(0, 15, 0, 5)
    Label.BackgroundTransparency = 1
    Label.Text = name
    Label.TextColor3 = THEME.Text
    Label.Font = Enum.Font.Gotham
    Label.TextSize = 13
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Parent = Frame

    local SliderBG = Instance.new("TextButton")
    SliderBG.Size = UDim2.new(1, -30, 0, 4)
    SliderBG.Position = UDim2.new(0, 15, 0, 48)
    SliderBG.BackgroundColor3 = THEME.Border
    SliderBG.Text = ""
    SliderBG.AutoButtonColor = false
    SliderBG.Parent = Frame

    local SliderFill = Instance.new("Frame")
    SliderFill.Size = UDim2.new(math.clamp((current - min)/(max - min), 0, 1), 0, 1, 0)
    SliderFill.BackgroundColor3 = THEME.Cold
    SliderFill.BorderSizePixel = 0
    SliderFill.Parent = SliderBG

    local ValueLabel = Instance.new("TextLabel")
    ValueLabel.Size = UDim2.new(0, 50, 0, 35)
    ValueLabel.Position = UDim2.new(1, -65, 0, 5)
    ValueLabel.BackgroundTransparency = 1
    ValueLabel.Text = string.format("%.2f", current)
    ValueLabel.TextColor3 = THEME.Cold
    ValueLabel.Font = Enum.Font.Code
    ValueLabel.TextSize = 12
    ValueLabel.TextXAlignment = Enum.TextXAlignment.Right
    ValueLabel.Parent = Frame

    local function update(input)
        local pos = math.clamp((input.Position.X - SliderBG.AbsolutePosition.X) / SliderBG.AbsoluteSize.X, 0, 1)
        SliderFill.Size = UDim2.new(pos, 0, 1, 0)
        local val = min + (max - min) * pos
        ValueLabel.Text = string.format("%.2f", val)
        callback(val)
    end

    local dragging = false
    SliderBG.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            update(input)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            update(input)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
    
    table.insert(CurrentSettings, Frame)
end


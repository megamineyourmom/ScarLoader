-- Inject function: safely executes app code with pcall
local function InjectApp(appName, code, guiParent, guiName)
    local success, err = pcall(function()
        local parentObj = guiParent == "PlayerGui" and playerGui or CoreGui
        local existing = parentObj:FindFirstChild(guiName)
        if existing then existing:Destroy() end
        
        local func, loadErr = loadstring(code)
        if not func then
            error("Failed to compile " .. appName .. ": " .. tostring(loadErr))
        end
        func()
    end)
    return success, err
end


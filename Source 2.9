-- HTTP helper: tries executor request(), then HttpService
local function httpGet(url, headers)
    headers = headers or {}
    local req = request or http_request
    if not req and syn and syn.request then req = syn.request end
    if not req and http and http.request then req = http.request end
    if req then
        local ok, res = pcall(req, { Url = url, Method = "GET", Headers = headers })
        if ok and type(res) == "table" and res.Body then
            local status = res.StatusCode
            if not status or (type(status) == "number" and status < 400) then
                return res.Body
            end
            return nil
        end
    end
    local ok, body = pcall(function()
        return HttpService:GetAsync(url, false, headers)
    end)
    if ok then
        return body
    end
    return nil
end

local function extractNextData(html)
    local marker = '<script id="__NEXT_DATA__" type="application/json">'
    local s = html:find(marker, 1, true)
    if not s then return nil end
    s = s + #marker
    local e = html:find('</script>', s, true)
    if not e then return nil end
    return html:sub(s, e - 1)
end


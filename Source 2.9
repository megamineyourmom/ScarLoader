local captchaTitle = create("TextLabel", {Size = UDim2.new(1, 0, 0, 40), BackgroundTransparency = 1, Text = "Verification Required", TextColor3 = ACCENT_COLOR, Font = THIN_FONT, TextSize = 22, Parent = captcha})
